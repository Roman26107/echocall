BOT_TOKEN=123456:telegram-bot-token
BOT_USERNAME=your_bot_username
ADMIN=0

# Public URL that users open from Telegram buttons.
# For production set your real domain, for example: https://call.example.com
DOMAIN=http://localhost

# Web app settings used only for local direct Flask run; Gunicorn binds in docker-compose command.
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
DEBUG=false

JITSI_DOMAIN=meet.jit.si

# PostgreSQL settings for docker-compose.
POSTGRES_DB=calls_tg
POSTGRES_USER=calls_tg
POSTGRES_PASSWORD=change_me_strong_password

# In docker-compose DATABASE_URL is generated from POSTGRES_* automatically.
# For local runs outside Docker you can use:
# DATABASE_URL=postgresql+psycopg2://calls_tg:change_me_strong_password@127.0.0.1:5432/calls_tg
