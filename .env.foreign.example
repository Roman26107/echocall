BOT_TOKEN=replace-with-telegram-token
BOT_USERNAME=your_bot_username
# One immutable tag is shared by bot and telegram-gateway.
APP_IMAGE=echocall-foreign-app:replace-with-git-commit
ADMIN=0
DOMAIN=https://app.example.com

INTERNAL_API_URL=https://api.example.com
INTERNAL_API_DOMAIN=api.example.com
# RF public IP for direct HTTPS; use FOREIGN_TUNNEL_GATEWAY_IP for SSH fallback.
INTERNAL_API_CONNECT_IP=198.51.100.20
INTERNAL_API_TOKEN=generate-32-or-more-random-bytes
INTERNAL_API_TIMEOUT=8
# Fixed, non-overlapping Docker network used by the restricted SSH fallback.
FOREIGN_APP_NETWORK_SUBNET=172.30.0.0/24
FOREIGN_TUNNEL_GATEWAY_IP=172.30.0.1

TELEGRAM_GATEWAY_TOKEN=generate-a-different-32-or-more-byte-secret
GATEWAY_DOMAIN=gateway.example.com
RF_SERVER_IP=198.51.100.20
# The container is published only on host loopback for the existing Caddy.
TELEGRAM_GATEWAY_LOCAL_PORT=8010
