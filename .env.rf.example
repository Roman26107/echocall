APP_DOMAIN=app.example.com
INTERNAL_API_DOMAIN=api.example.com
MEET_DOMAIN=meet.example.com
# Container port on the shared RF app network; it is not host-published.
JITSI_HTTP_PORT=8000
# One immutable tag is shared by migrate, web and internal-api.
APP_IMAGE=echocall-rf-app:replace-with-git-commit
DOMAIN=https://app.example.com
JITSI_DOMAIN=meet.example.com
BOT_USERNAME=your_bot_username

POSTGRES_DB=calls_tg
POSTGRES_USER=calls_tg
POSTGRES_PASSWORD=generate-a-long-random-password
REDIS_PASSWORD=generate-another-long-random-password

# Same value as INTERNAL_API_TOKEN on the foreign server.
INTERNAL_API_TOKEN=generate-32-or-more-random-bytes

# Use :8443 when the foreign VPS opens the restricted reverse-SSH fallback
# documented in DEPLOY_SPLIT.md. The hostname still provides TLS SNI/verification.
TELEGRAM_GATEWAY_URL=https://gateway.example.com:8443
# Same value as TELEGRAM_GATEWAY_TOKEN on the foreign server.
TELEGRAM_GATEWAY_TOKEN=generate-a-different-32-or-more-byte-secret
TELEGRAM_GATEWAY_TIMEOUT=8
# Keep this subnet stable: restricted reverse SSH listens only on its gateway.
APP_NETWORK_SUBNET=172.29.0.0/24
TUNNEL_GATEWAY_IP=172.29.0.1

# Exact public source IP of the foreign server, without CIDR.
FOREIGN_SERVER_IP=203.0.113.10
# Host directory with app/, api/ and meet/ fullchain.pem + privkey.pem pairs.
TLS_CERT_DIR=/etc/echocall/certs
# Shared Certbot webroot mounted read-only into Nginx.
ACME_WEBROOT_DIR=/var/www/echocall-acme
