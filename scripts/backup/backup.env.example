# Install as /etc/echocall-backup/backup.env with mode 600.
POSTGRES_CONTAINER=echocall-rf-postgres-1
STAGING_DIR=/var/lib/echocall-backup/staging
RESTIC_CACHE_DIR=/var/cache/echocall-backup/restic
RESTIC_PASSWORD_FILE=/etc/echocall-backup/restic-password

# The foreign account is chrooted; the repository path is relative to its root.
RESTIC_REPOSITORY_FOREIGN=sftp:echocall-backup@203.0.113.10:/repository/restic
SFTP_USER=echocall-backup
SFTP_HOST=203.0.113.10
SFTP_IDENTITY_FILE=/etc/echocall-backup/id_ed25519
SFTP_KNOWN_HOSTS_FILE=/etc/echocall-backup/known_hosts

# Configure this remote with official Google OAuth before repository init.
RESTIC_REPOSITORY_GOOGLE=rclone:google-drive:EchoCall-Backups/restic
RCLONE_CONFIG=/etc/echocall-backup/rclone.conf

KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
