[Unit]
Description=EchoCall restricted manual backup trigger
Requires=docker.service
After=docker.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=echocall-backup-trigger
RuntimeDirectoryMode=0700
ExecStart=/usr/local/sbin/echocall-backup-trigger
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/echocall-backup-trigger

[Install]
WantedBy=multi-user.target
